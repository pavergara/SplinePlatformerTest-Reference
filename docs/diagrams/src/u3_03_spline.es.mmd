%% U3 - 03 2.5D Spline Navigation (Español)
%% Basado en BP_SplineCharacter_Restruct, BP_SplineRoute, BP_JunctionTrigger, BPI_SetRouteAndPosition
%% Los nombres de assets, nodos e interfaces se mantienen sin traducir.
flowchart TD
    classDef input fill:#4A154B,stroke:#333,stroke-width:2px,color:#fff;
    classDef player fill:#1A365D,stroke:#333,stroke-width:2px,color:#fff;
    classDef world fill:#1C6434,stroke:#333,stroke-width:2px,color:#fff;
    classDef route fill:#7B341E,stroke:#333,stroke-width:2px,color:#fff;

    subgraph CapaInput ["ENTRADA"]
        A["A / D (Enhanced Input)"] -->|Eje de movimiento| B["BP_SplineCharacter_Restruct: Event Tick"]
    end

    subgraph CapaMovimiento ["PIPELINE DE MOVIMIENTO (2.5D)"]
        B --> C["AuxGetDeltaDistanceCurrentAndPossible()"]
        C --> D["CurrentDistanceAlongSpline"]
        D --> E["SplinePath (BP_SplineRoute) - GetLocationAtDistanceAlongSpline"]
        E --> F["K2_SetActorLocation (Z-Offset)"]
        F --> G["Spring arm de cámara: TargetCameraYaw / Pitch / Zoom"]
        B --> H["VelocityDeathZone()"]
        H --> D
    end

    subgraph CapaRuta ["CAMBIO DE RUTA"]
        I["BP_JunctionTrigger: solapamiento de Box"] --> J["BPI_TriggerInteract: OnPlayerOverlap"]
        J --> K["ChangePath(): SplineRouteUp / SplineRouteDown / SplineRouteTrunk"]
        K --> L["BP_PlayerController: BPI_SetRouteAndPosition"]
        L --> M["BP_SplineCharacter_Restruct: ChangeSpline(NewSpline)"]
        M --> E
    end

    class A,B input;
    class C,D,E,F,G,H,M player;
    class I,J,K world;
    class L route;
